end)()

-- Silent Aim Module (Solo jugadores, sin NPCs)
SilentAimModule = (function()
	local module = {}
	local SilentAimPlayersEnabled = false
	local PredictionEnabled = true; local PredictionAmount = 0.12
	local ShowFOVCircle = false; local FOVRadius = 100; local FOVMode = "V1"; local AimMode = "360"; local TargetPriority = "Nearest"
	local TracerEnabled = false; local TracerColor = "Red"; local tracerModel, tracerAttachment0, tracerAttachment1, tracerBeam = nil, nil, nil, nil
	local renderConnection, characterConnections = nil, {}
	local PlayersPosition = nil; local Selectedplayer = nil; local maxRange = 1000
	local BlacklistedKeys = {
		Melee = { Z=false, X=false, C=false },
		Sword = { Z=false, X=false },
		Fruit = { Z=false, X=false, C=false, V=false, F=false, TAP=false },
		Gun   = { Z=false, X=false }
	}
	local currentToolCategory = "Melee"; local currentSkillKey = nil; local SKILL_KEYS = {"Z","X","C","V","F","TAP"}
	local lastDirection = nil

	local fovGui = Instance.new("ScreenGui"); fovGui.Name = "DarkWare_FOV"; fovGui.ResetOnSpawn = false; fovGui.IgnoreGuiInset = true; fovGui.Parent = parentGui
	local FOVFrame = Instance.new("Frame"); FOVFrame.AnchorPoint = Vector2.new(0.5, 0.5); FOVFrame.BackgroundTransparency = 1; FOVFrame.Visible = false; FOVFrame.Parent = fovGui
	local stroke = Instance.new("UIStroke"); stroke.Color = Color3.fromRGB(255, 0, 0); stroke.Thickness = 2; stroke.Parent = FOVFrame
	local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(1, 0); corner.Parent = FOVFrame

	local function getHRP(model) return model and model:FindFirstChild("HumanoidRootPart") end
	local function getToolCategory(tool)
		if not tool then return "Melee" end
		local n = string.lower(tool.Name)
		for _, g in ipairs({"guitar","rifle","cannon","gun","slingshot","kabucha","bow"}) do if string.find(n, g) then return "Gun" end end
		for _, m in ipairs({"claw","godhuman","superhuman","talon","step","karate","breath","kung fu","combat","fist","sanguine"}) do if string.find(n, m) then return "Melee" end end
		if string.find(n, "fruit") or string.find(n, "-") then return "Fruit" end
		return "Sword"
	end

	local function predicted(hrp)
		if not hrp then return nil end
		local hum = hrp.Parent:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return hrp.Position end
		if not PredictionEnabled then return hrp.Position end
		local vel = hrp.Velocity
		if vel.Magnitude < 5 then lastDirection = nil; return hrp.Position end
		local dir = vel.Unit
		if lastDirection and lastDirection:Dot(dir) < 0.7 then lastDirection = nil; return hrp.Position end
		lastDirection = dir
		local ping = 0
		pcall(function() ping = math.clamp((Stats.Network.ServerStatsItem["Data Ping"]:GetValue() or 0) / 1000, 0, 0.35) end)
		local factor = math.min(PredictionAmount + ping, vel.Magnitude > 100 and 0.15 or 1)
		return hrp.Position + (vel * factor)
	end

	local function isTargetProtected(targetPlayer)
		local char = targetPlayer and targetPlayer.Character; if not char then return false end
		if char:GetAttribute("SafeZone") == true or char:GetAttribute("PvpDisabled") == true or targetPlayer:GetAttribute("PvpDisabled") == true then return true end
		if char:FindFirstChildWhichIsA("ForceField") then return true end
		return false
	end

	local function isEnemy(targetPlayer)
		if not targetPlayer or targetPlayer == player or isTargetProtected(targetPlayer) then return false end
		local mt, tt = player.Team, targetPlayer.Team
		if mt and tt and mt.Name == "Marines" and tt.Name == "Marines" then return false end
		return true
	end

	local function getFOVCenter()
		if FOVMode == "V2" then return UserInputService:GetMouseLocation() end
		return camera.ViewportSize / 2
	end

	local function isTargetValid(hrp, lpHRP)
		if not hrp or not lpHRP then return false end
		if AimMode == "180" then
			return lpHRP.CFrame.LookVector:Dot((hrp.Position - lpHRP.Position).Unit) >= 0
		elseif AimMode == "FOV" then
			local sp, onScr = camera:WorldToViewportPoint(hrp.Position)
			if not onScr then return false end
			return (Vector2.new(sp.X, sp.Y) - getFOVCenter()).Magnitude <= FOVRadius
		end
		return true
	end

	local function getClosestPlayer(lpHRP)
		if not lpHRP then return nil end
		if TargetPriority == "Lock Player" then
			if Selectedplayer and Selectedplayer.Character and not isTargetProtected(Selectedplayer) then
				local hum = Selectedplayer.Character:FindFirstChildWhichIsA("Humanoid"); local hrp = getHRP(Selectedplayer.Character)
				if hum and hum.Health > 0 and hrp and isTargetValid(hrp, lpHRP) and (hrp.Position - lpHRP.Position).Magnitude <= maxRange then
					return Selectedplayer
				end
			end
			return nil
		end
		local valid = {}
		for _, pl in ipairs(Players:GetPlayers()) do
			if pl ~= player and isEnemy(pl) and pl.Character then
				local hum = pl.Character:FindFirstChildWhichIsA("Humanoid"); local hrp = getHRP(pl.Character)
				if hum and hum.Health > 0 and hrp and isTargetValid(hrp, lpHRP) then
					local d = (hrp.Position - lpHRP.Position).Magnitude
					if d <= maxRange then table.insert(valid, { Player = pl, Humanoid = hum, HRP = hrp, Distance = d }) end
				end
			end
		end
		if #valid == 0 then return nil end
		if AimMode == "360" or AimMode == "180" then
			if TargetPriority == "Nearest" then table.sort(valid, function(a,b) return a.Distance < b.Distance end)
			elseif TargetPriority == "Low HP" then table.sort(valid, function(a,b) return a.Humanoid.Health < b.Humanoid.Health end)
			elseif TargetPriority == "Looking At Me" then table.sort(valid, function(a,b)
				return a.HRP.CFrame.LookVector:Dot((lpHRP.Position - a.HRP.Position).Unit) > b.HRP.CFrame.LookVector:Dot((lpHRP.Position - b.HRP.Position).Unit)
			end) end
		else
			local c = getFOVCenter()
			table.sort(valid, function(a,b)
				local pA = camera:WorldToViewportPoint(a.HRP.Position); local pB = camera:WorldToViewportPoint(b.HRP.Position)
				return (Vector2.new(pA.X, pA.Y) - c).Magnitude < (Vector2.new(pB.X, pB.Y) - c).Magnitude
			end)
		end
		return valid[1].Player
	end

	local function createTracer()
		if tracerModel then return end
		tracerModel = Instance.new("Model", workspace); tracerModel.Name = "DarkWareTracer"
		tracerAttachment0 = Instance.new("Attachment", tracerModel); tracerAttachment1 = Instance.new("Attachment", tracerModel)
		tracerBeam = Instance.new("Beam", tracerModel); tracerBeam.Attachment0 = tracerAttachment0; tracerBeam.Attachment1 = tracerAttachment1
		tracerBeam.Width0 = 0.1; tracerBeam.Width1 = 0.1; tracerBeam.FaceCamera = true
		local colors = { Red=Color3.fromRGB(255,0,0), Green=Color3.fromRGB(0,255,0), Blue=Color3.fromRGB(0,0,255), Yellow=Color3.fromRGB(255,255,0), White=Color3.fromRGB(255,255,255) }
		tracerBeam.Color = ColorSequence.new(colors[TracerColor] or Color3.fromRGB(255,0,0))
	end

	local function destroyTracer()
		if tracerModel then tracerModel:Destroy(); tracerModel = nil; tracerAttachment0 = nil; tracerAttachment1 = nil; tracerBeam = nil end
	end

	local function startLoop()
		if renderConnection then return end
		renderConnection = RunService.RenderStepped:Connect(function()
			if ShowFOVCircle then
				local c = getFOVCenter()
				FOVFrame.Position = UDim2.new(0, c.X, 0, c.Y); FOVFrame.Size = UDim2.new(0, FOVRadius*2, 0, FOVRadius*2); FOVFrame.Visible = true
			else
				FOVFrame.Visible = false
			end
			local lpHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if not SilentAimPlayersEnabled or not lpHRP then
				if tracerBeam then tracerBeam.Enabled = false end
				PlayersPosition = nil; return
			end
			local tp = getClosestPlayer(lpHRP)
			PlayersPosition = (tp and tp.Character) and predicted(getHRP(tp.Character)) or nil
			if TracerEnabled and tracerBeam and tracerAttachment0 and tracerAttachment1 then
				if PlayersPosition then tracerAttachment0.WorldPosition = lpHRP.Position; tracerAttachment1.WorldPosition = PlayersPosition; tracerBeam.Enabled = true
				else tracerBeam.Enabled = false end
			end
		end)
	end

	local function stopLoop()
		if renderConnection then renderConnection:Disconnect(); renderConnection = nil end
		FOVFrame.Visible = false; destroyTracer(); PlayersPosition = nil
	end

	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		local map = { [Enum.KeyCode.Z]="Z", [Enum.KeyCode.X]="X", [Enum.KeyCode.C]="C", [Enum.KeyCode.V]="V", [Enum.KeyCode.F]="F" }
		if map[input.KeyCode] then currentSkillKey = map[input.KeyCode] end
	end)

	if hookmetamethod then
		pcall(function()
			local oldNamecall
			oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
				local args = { ... }
				local method = getnamecallmethod and tostring(getnamecallmethod()) or ""
				if SilentAimPlayersEnabled and PlayersPosition and method == "FireServer" and args[1] ~= "TAP" then
					local bl = currentSkillKey and BlacklistedKeys[currentToolCategory] and BlacklistedKeys[currentToolCategory][currentSkillKey]
					if not bl then
						for i, arg in ipairs(args) do
							if typeof(arg) == "Vector3" then args[i] = PlayersPosition end
						end
					end
				end
				return oldNamecall(self, unpack(args))
			end))
		end)
	end

	local function hookChar(char)
		for _, c in ipairs(characterConnections) do pcall(function() c:Disconnect() end) end
		characterConnections = {}
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then
			table.insert(characterConnections, hum.AnimationPlayed:Connect(function(track)
				local anim = track.Animation; local id = anim and tostring(anim.AnimationId):match("%d+")
				local n = string.lower(anim and anim.Name or "")
				if bunnyHopEnabled and (string.find(n, "dash") or string.find(n, "flashstep") or id == "17555632156" or id == "1846164274" or id == "1846163351") then
					task.spawn(function()
						task.wait(0.05)
						if hum and hum.FloorMaterial ~= Enum.Material.Air then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
					end)
				end
			end))
		end
		table.insert(characterConnections, char.ChildAdded:Connect(function(ch)
			if ch:IsA("Tool") then currentToolCategory = getToolCategory(ch); currentSkillKey = nil end
		end))
	end
	player.CharacterAdded:Connect(hookChar)
	if player.Character then hookChar(player.Character) end

	function module:SetPlayerSilentAim(st) SilentAimPlayersEnabled = st; if st then startLoop() else stopLoop() end end
	function module:SetSelectedPlayer(name) Selectedplayer = (name and name ~= "" and name ~= "None") and Players:FindFirstChild(name) or nil end
	function module:SetAimMode(m) AimMode = m end
	function module:SetTargetPriority(p) TargetPriority = p end
	function module:SetShowFOVCircle(st) ShowFOVCircle = st end
	function module:SetFOVRadius(r) FOVRadius = r end
	function module:SetFOVMode(m) FOVMode = m end
	function module:SetDistanceLimit(r) if type(r) == "number" then maxRange = r end end
	function module:SetTracerEnabled(st) TracerEnabled = st; if st then createTracer() else destroyTracer() end end
	function module:SetTracerColor(c) TracerColor = c; if tracerBeam then destroyTracer(); if TracerEnabled then createTracer() end end end
	function module:SetBlacklistKey(cat, key, st) if BlacklistedKeys[cat] and BlacklistedKeys[cat][key] ~= nil then BlacklistedKeys[cat][key] = st end end
	return module
end)()

