local function makeToggleRow(parent, text, initial, cb)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -4, 0, 26)
    row.BackgroundColor3 = Color3.fromRGB(22, 19, 32)
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0.72, 0, 1, 0)
    lbl.Position = UDim2.new(0, 8, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 10
    lbl.TextColor3 = Color3.fromRGB(240, 240, 245)
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local state = initial
    local btn = Instance.new("TextButton", row)
    btn.Size = UDim2.new(0, 44, 0, 18)
    btn.Position = UDim2.new(1, -50, 0.5, -9)
    btn.BackgroundColor3 = state and Color3.fromRGB(170, 0, 255) or Color3.fromRGB(45, 40, 58)
    btn.Text = state and "ON" or "OFF"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 9
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

    local function apply(val)
        state = val
        btn.BackgroundColor3 = state and Color3.fromRGB(170, 0, 255) or Color3.fromRGB(45, 40, 58)
        btn.Text = state and "ON" or "OFF"
        cb(state)
    end

    btn.MouseButton1Click:Connect(function()
        apply(not state)
        SaveDarkWarePvP()
    end)

    return apply
end

local function makeStepRow(parent, text, minV, maxV, stepV, getV, setV, suffix)
    local row = Instance.new("Frame", parent)
    row.Size = UDim2.new(1, -4, 0, 26)
    row.BackgroundColor3 = Color3.fromRGB(22, 19, 32)
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UDim2.new(0.54, 0, 1, 0)
    lbl.Position = UDim2.new(0, 8, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 10
    lbl.TextColor3 = Color3.fromRGB(240, 240, 245)
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local minus = Instance.new("TextButton", row)
    minus.Size = UDim2.new(0, 20, 0, 18)
    minus.Position = UDim2.new(1, -86, 0.5, -9)
    minus.BackgroundColor3 = Color3.fromRGB(40, 35, 55)
    minus.Text = "-"
    minus.Font = Enum.Font.GothamBold
    minus.TextSize = 11
    minus.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 4)

    local valLbl = Instance.new("TextLabel", row)
    valLbl.Size = UDim2.new(0, 42, 0, 18)
    valLbl.Position = UDim2.new(1, -64, 0.5, -9)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = tostring(getV()) .. (suffix or "")
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 9.5
    valLbl.TextColor3 = Color3.fromRGB(200, 150, 255)

    local plus = Instance.new("TextButton", row)
    plus.Size = UDim2.new(0, 20, 0, 18)
    plus.Position = UDim2.new(1, -22, 0.5, -9)
    plus.BackgroundColor3 = Color3.fromRGB(40, 35, 55)
    plus.Text = "+"
    plus.Font = Enum.Font.GothamBold
    plus.TextSize = 11
    plus.TextColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 4)

    minus.MouseButton1Click:Connect(function()
        local nv = math.max(minV, math.floor((getV() - stepV) * 100 + 0.5) / 100)
        setV(nv)
        valLbl.Text = tostring(nv) .. (suffix or "")
        SaveDarkWarePvP()
    end)

    plus.MouseButton1Click:Connect(function()
        local nv = math.min(maxV, math.floor((getV() + stepV) * 100 + 0.5) / 100)
        setV(nv)
        valLbl.Text = tostring(nv) .. (suffix or "")
        SaveDarkWarePvP()
    end)
end

