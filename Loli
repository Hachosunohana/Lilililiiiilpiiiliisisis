                        if eHRP and myHRP and (myHRP.Position - eHRP.Position).Magnitude <= PvPConfig.SoruMaxDist then
                            if key == "Hit" then return CFrame.new(eHRP.Position) end
                            if key == "Target" then return eHRP end
