                    if key == "Hit" then return CFrame.new(currentSilentAimTarget.Position) end
                    if key == "Target" then return currentSilentAimTarget end
                end
            end
            return oldIndex(self, key)
        end))
    end)

    local oldNamecall
    pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local args = { ... }
            local method = getnamecallmethod and tostring(getnamecallmethod()):lower() or ""

            if not checkcaller() and PvPConfig.SilentAimSkill and currentSilentAimTarget then
                if method == "fireserver" or method == "invokeserver" then
                    local pos = currentSilentAimTarget.Position
                    if self.Name:find("RegisterHit") then
                        local targetChar = currentSilentAimTarget.Parent
                        local head = targetChar and (targetChar:FindFirstChild("Head") or currentSilentAimTarget)
                        if head and targetChar then
                            args[1] = head
                            args[2] = { { targetChar, head } }
                            return oldNamecall(self, unpack(args))
                        end
                    elseif self.Name:find("ShootGunEvent") then
                        args[1] = pos
                        if currentSilentAimTarget.Parent then
                            args[2] = { currentSilentAimTarget.Parent }
                        end
                        return oldNamecall(self, unpack(args))
                    end
                    for i, arg in ipairs(args) do
                        if typeof(arg) == "Vector3" then
                            args[i] = pos
                        elseif typeof(arg) == "CFrame" then
                            args[i] = CFrame.new(pos)
                        end
                    end
                    return oldNamecall(self, unpack(args))
                elseif method == "raycast" then
                    return {
                        Instance = currentSilentAimTarget,
                        Position = currentSilentAimTarget.Position,
                        Hit = currentSilentAimTarget.Position,
                        Normal = Vector3.new(0, 1, 0),
                        Material = Enum.Material.SmoothPlastic
                    }
                end
            end
            return oldNamecall(self, ...)
        end))
    end)
end

