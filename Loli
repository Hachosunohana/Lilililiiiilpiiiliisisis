local function isSameTeam(plr)
	if not player.Team or not plr.Team then
		return false
	end
	return player.Team == plr.Team
end

local function isValidBloxFruitsTarget(plr)
	if not plr or plr == player or not plr.Character then
		return nil
	end
	if isSameTeam(plr) then
		return nil
	end
	local hum = plr.Character:FindFirstChildOfClass("Humanoid")
	local part = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("UpperTorso") or plr.Character:FindFirstChild("Head")
	if hum and hum.Health > 0 and part and part:IsA("BasePart") then
		return part
	end
	return nil
end

local function resolveSilentAimTarget()
	if aimState.mode ~= "Nearest" then
		local chosenPlr = Players:FindFirstChild(aimState.mode)
		local part = isValidBloxFruitsTarget(chosenPlr)
		if part then
			return chosenPlr, part
		end
		return nil, nil
	end

	local vp = camera.ViewportSize
	local center = Vector2.new(vp.X * 0.5, vp.Y * 0.5)
	local maxRadius = aimState.fovSize * 0.5
	local bestPlr = nil
	local bestPart = nil
	local bestScore = maxRadius

	for _, plr in ipairs(Players:GetPlayers()) do
		local part = isValidBloxFruitsTarget(plr)
		if part then
			local screenPos, onScreen = camera:WorldToViewportPoint(part.Position)
			if onScreen and screenPos.Z > 0 then
				local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
				if screenDist <= bestScore then
					bestScore = screenDist
					bestPlr = plr
					bestPart = part
				end
			end
		end
	end

	return bestPlr, bestPart
end

-- Redirecionamento seguro para ataques/habilidades baseados em Mouse e Raycast de workspace (sem mover câmera nem WalkSpeed)
local hooksInstalled = false
local function installBloxFruitsSilentHooks()
	if hooksInstalled then return end
	if not hookmetamethod or not getnamecallmethod then return end
	hooksInstalled = true

	pcall(function()
		local oldNamecall
		oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
			if aimState.enabled and currentTargetPart and currentTargetPart.Parent then
				local method = getnamecallmethod()
				local targetPos = currentTargetPart.Position

				if method == "Raycast" and self == workspace then
					local args = {...}
					if typeof(args[1]) == "Vector3" then
						args[2] = (targetPos - args[1]).Unit * 1000
						return oldNamecall(self, table.unpack(args))
					end
				elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist" then
					local args = {...}
					if typeof(args[1]) == "Ray" then
						local origin = args[1].Origin
						args[1] = Ray.new(origin, (targetPos - origin).Unit * 1000)
						return oldNamecall(self, table.unpack(args))
					end
				end
			end
			return oldNamecall(self, ...)
		end)

		if mouse then
			local oldIndex
			oldIndex = hookmetamethod(game, "__index", function(self, key)
				if aimState.enabled and currentTargetPart and currentTargetPart.Parent and self == mouse then
					local targetPos = currentTargetPart.Position
					if key == "Hit" then
						return CFrame.new(targetPos)
					elseif key == "Target" then
						return currentTargetPart
					elseif key == "UnitRay" then
						local origin = camera.CFrame.Position
						return Ray.new(origin, (targetPos - origin).Unit)
					end
				end
				return oldIndex(self, key)
			end)
		end
	end)
end

task.defer(installBloxFruitsSilentHooks)

local function getSingleFactionText()
	local team = player.Team
	if not team then
		return "Neutral"
	end
	local lowerName = string.lower(team.Name)
	if string.find(lowerName, "marine", 1, true) then
		return "Marines"
	end
	if string.find(lowerName, "pirate", 1, true) then
		return "Pirates"
	end
	return team.Name
end

local function getPingMs()
	local pingValue = 0
	pcall(function()
		local netItem = Stats.Network and Stats.Network:FindFirstChild("ServerStatsItem")
		local dataPing = netItem and netItem:FindFirstChild("Data Ping")
		if dataPing then
			pingValue = tonumber(dataPing:GetValue()) or 0
		end
	end)
	if pingValue <= 0 then
		pcall(function()
			pingValue = (player:GetNetworkPing() or 0) * 1000
		end)
	end
	return math.clamp(math.floor(pingValue + 0.5), 1, 999)
end

local function updateStatusAndTarget(fpsValue)
	local currentPlayers = #Players:GetPlayers()
	local maxPlayers = math.max(Players.MaxPlayers or 12, currentPlayers)
	local pingMs = getPingMs()
	local faction = getSingleFactionText()

	fpsPingLine.Text = string.format("Fps | %d  Ping | %d", fpsValue, pingMs)
	playersLine.Text = string.format("Players | %d/%d", currentPlayers, maxPlayers)
	myTeamLine.Text = "My Team | " .. faction

	local targetPlr = currentTargetPlayer
	if not targetPlr and aimState.mode ~= "Nearest" then
		targetPlr = Players:FindFirstChild(aimState.mode)
	end

	if targetPlr and targetPlr:IsA("Player") and targetPlr ~= player and targetPlr.Character then
		local hum = targetPlr.Character:FindFirstChildOfClass("Humanoid")
		local root = targetPlr.Character:FindFirstChild("HumanoidRootPart") or targetPlr.Character:FindFirstChild("Head")
		local myRoot = player.Character and (player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("Head"))

		local hpText = "--"
		if hum then
			hpText = string.format("%d/%d", math.max(0, math.floor(hum.Health)), math.max(1, math.floor(hum.MaxHealth)))
		end

		local distText = "--"
		if root and myRoot and root:IsA("BasePart") and myRoot:IsA("BasePart") then
			distText = string.format("%dm", math.floor((root.Position - myRoot.Position).Magnitude))
		end

		targetNameLine.Text = "Target | " .. targetPlr.Name
		targetInfoLine.Text = string.format("HP | %s  Dist | %s", hpText, distText)
	else
		targetNameLine.Text = "Target | None"
		targetInfoLine.Text = "HP | --  Dist | --"
	end
end

