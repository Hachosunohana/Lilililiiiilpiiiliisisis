local function rebuildAimModes()
	local previous = aimState.mode
	modeOptions = {"Nearest"}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			table.insert(modeOptions, plr.Name)
		end
	end

	modeIndex = 1
	for i, opt in ipairs(modeOptions) do
		if opt == previous then
			modeIndex = i
			break
		end
	end

	aimState.mode = modeOptions[modeIndex] or "Nearest"
	modeValue.Text = aimState.mode
	refreshCombatStatusLabel()
end

modeCard.MouseButton1Click:Connect(function()
	if #modeOptions == 0 then
		rebuildAimModes()
		return
	end
	modeIndex = (modeIndex % #modeOptions) + 1
	aimState.mode = modeOptions[modeIndex]
	modeValue.Text = aimState.mode
	refreshCombatStatusLabel()
end)

Players.PlayerAdded:Connect(rebuildAimModes)
Players.PlayerRemoving:Connect(rebuildAimModes)
rebuildAimModes()

