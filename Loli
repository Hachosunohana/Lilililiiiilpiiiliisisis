local elapsedTime = 0
local statsTimer = 0
local aimTimer = 0
local frameCounter = 0
local cachedFps = 60
local renderConn
renderConn = RunService.RenderStepped:Connect(function(dt)
	if not screenGui.Parent then
		renderConn:Disconnect()
		return
	end

	elapsedTime += dt
	statsTimer += dt
	aimTimer += dt
	frameCounter += 1

	for _, grad in ipairs(animatedGradients) do
		grad.Rotation = (grad.Rotation + dt * 135) % 360
	end

	if fxLayer.Visible then
		for _, d in ipairs(rainDrops) do
			d.y += dt * d.speed
			d.x -= dt * d.speed * 0.12
			if d.y > 1.05 then d.y = -0.05 end
			if d.x < -0.02 then d.x = 1.02 end
			d.frame.Position = UDim2.new(d.x, 0, d.y, 0)
		end

		for _, s in ipairs(stars) do
			s.frame.BackgroundTransparency = 0.25 + 0.45 * (0.5 + 0.5 * math.sin(elapsedTime * s.speed + s.phase))
		end
	end

	if aimTimer >= 0.08 then
		aimTimer = 0
		if aimState.enabled then
			local plr, part = resolveSilentAimTarget()
			currentTargetPlayer = plr
			currentTargetPart = part
		else
			currentTargetPlayer = nil
			currentTargetPart = nil
		end
	end

	if statsTimer >= 0.3 then
		cachedFps = math.clamp(math.floor((frameCounter / statsTimer) + 0.5), 1, 999)
		frameCounter = 0
		statsTimer = 0
		updateStatusAndTarget(cachedFps)
	end
end)

task.spawn(function()
	local totalDuration = 9
	local sprintStart = 8.15
	local elapsed = 0

	while elapsed < totalDuration do
		local dt = RunService.RenderStepped:Wait()
		elapsed = math.min(totalDuration, elapsed + dt)

		local pct
		if elapsed < sprintStart then
			local preT = elapsed / sprintStart
			pct = math.floor(1 + (preT ^ 1.35) * 71)
		else
			local sprintT = (elapsed - sprintStart) / (totalDuration - sprintStart)
			local easedSprint = 1 - ((1 - sprintT) ^ 2.4)
			pct = math.floor(72 + easedSprint * 28)
		end

		pct = math.clamp(pct, 1, 100)
		introPercent.Text = tostring(pct) .. "%"
		introBar.Size = UDim2.new(pct / 100, 0, 1, 0)
	end

	introPercent.Text = "100%"
	introBar.Size = UDim2.new(1, 0, 1, 0)
	task.wait(0.35)

	TweenService:Create(introFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 1
	}):Play()
	TweenService:Create(introTitle, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1
	}):Play()
	TweenService:Create(introPercent, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1
	}):Play()
	TweenService:Create(introTrack, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
		BackgroundTransparency = 1
	}):Play()
	TweenService:Create(introBar, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
		BackgroundTransparency = 1
	}):Play()

	task.wait(0.25)
	introFrame.Visible = false
	openTab("Home")
end)
