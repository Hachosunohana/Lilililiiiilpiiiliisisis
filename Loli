local antiStunHeartbeatConn = nil
local antiStunInputConn = nil
local noCDCharConnection = nil
local SanguineAutoConnection = nil
local SanguineAutoCooldown = false
local sanguineLagBusy = false

local function enableAntiStunHitbox()
    PvPConfig.AntiStunHitbox = true
    if antiStunHeartbeatConn then antiStunHeartbeatConn:Disconnect() end
    antiStunHeartbeatConn = RunService.Heartbeat:Connect(function()
        if not PvPConfig.AntiStunHitbox then return end
        pcall(function()
            local char = player.Character
            if not char then return end
            char:SetAttribute("AllCooldown", 0)
            char:SetAttribute("FlashstepCooldown", 1)
            char:SetAttribute("UsingSkill", false)
            char:SetAttribute("isUsingSkill", false)
            char:SetAttribute("Busy", false)
            local hum = char:FindFirstChildOfClass("Humanoid")
            local root = char:FindFirstChild("HumanoidRootPart")
            if hum and hum.WalkSpeed < 16 then hum.WalkSpeed = 16 end
            if root then
                for _, v in ipairs(root:GetChildren()) do
                    if v:IsA("BodyVelocity") or v:IsA("BodyPosition") then
                        v:Destroy()
                    end
                end
            end
        end)
    end)

    if antiStunInputConn then antiStunInputConn:Disconnect() end
    antiStunInputConn = UserInputService.InputBegan:Connect(function(input, gp)
        if not PvPConfig.AntiStunHitbox or gp then return end
        local char = player.Character
        local darkBlade = char and char:FindFirstChild("Dark Blade")
        if darkBlade and darkBlade:FindFirstChild("RemoteEvent") then
            if input.KeyCode == Enum.KeyCode.Z then
                darkBlade.RemoteEvent:FireServer("Z")
            elseif input.KeyCode == Enum.KeyCode.X then
                darkBlade.RemoteEvent:FireServer("X")
            end
        end
    end)
end

local function disableAntiStunHitbox()
    PvPConfig.AntiStunHitbox = false
    if antiStunHeartbeatConn then antiStunHeartbeatConn:Disconnect(); antiStunHeartbeatConn = nil end
    if antiStunInputConn then antiStunInputConn:Disconnect(); antiStunInputConn = nil end
end

local function setSanguineNoCD(state)
    PvPConfig.SanguineNoCD = state
    if state then
        if player.Character then player.Character:SetAttribute("AllCooldown", 3) end
        noCDCharConnection = player.CharacterAdded:Connect(function(char)
            if PvPConfig.SanguineNoCD then char:SetAttribute("AllCooldown", 3) end
        end)
    else
        if noCDCharConnection then noCDCharConnection:Disconnect(); noCDCharConnection = nil end
        if player.Character then player.Character:SetAttribute("AllCooldown", nil) end
    end
end

local function dropFPS(duration)
    if sanguineLagBusy then return end
    sanguineLagBusy = true
    local DROP_TO_FPS = 20
    local stop = tick() + duration
    local interval = 1 / DROP_TO_FPS
    local con
    con = RunService.RenderStepped:Connect(function()
        if tick() > stop then
            if con then con:Disconnect() end
            sanguineLagBusy = false
            return
        end
        local now = tick()
        while tick() - now < interval do end
    end)
end

local function impulseSanguineZ(duration)
    dropFPS(duration)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local dir = camera.CFrame.LookVector
        local att = Instance.new("Attachment")
        att.Parent = hrp
        local lv = Instance.new("LinearVelocity")
        lv.MaxForce = math.huge
        lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        lv.VectorVelocity = dir * 400
        lv.Attachment0 = att
