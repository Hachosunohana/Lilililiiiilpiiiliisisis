-- ESP PVP (NOMBRE, NIVEL, BOUNTY, FRUTA, DISTANCIA, HP, HIGHLIGHT)
-- ============================================================
local espObjects = {}
local espRunning = false
local lastESPUpdate = 0

local function getTeamInfo(targetP)
    if not targetP or not targetP.Team then
        return "Unknown", Color3.fromRGB(255, 255, 255)
    end
    if targetP.Team.Name == "Marines" then
        return "Marines", Color3.fromRGB(0, 170, 255)
    end
    return "Pirates", Color3.fromRGB(255, 70, 70)
end

local function removeESP(targetP)
    if espObjects[targetP] then
        pcall(function()
            if espObjects[targetP].gui then espObjects[targetP].gui:Destroy() end
            if espObjects[targetP].highlight then espObjects[targetP].highlight:Destroy() end
        end)
        espObjects[targetP] = nil
    end
end

local function DisableESP()
    espRunning = false
    for p in pairs(espObjects) do
        removeESP(p)
    end
    espObjects = {}
end

local function createESP(targetP)
    if not targetP or targetP == player then return end
    local char = targetP.Character
    local head = char and char:FindFirstChild("Head")
    if not head then return end

    local _, color = getTeamInfo(targetP)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DarkWare_ESP"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 200, 0, 75)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = head

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextSize = PvPConfig.ESP_TextSize
    label.RichText = true
    label.Font = Enum.Font.SourceSansBold
    label.TextStrokeTransparency = 0
    label.TextColor3 = color
    label.Parent = billboard

    local hl = nil
    if PvPConfig.ESP_Highlight then
        hl = Instance.new("Highlight")
        hl.Name = "DarkWare_ESP_HL"
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.FillColor = Color3.fromRGB(255, 0, 0)
        hl.FillTransparency = 0.5
        hl.OutlineColor = Color3.fromRGB(255, 0, 0)
        hl.Parent = char
    end

    espObjects[targetP] = { gui = billboard, label = label, char = char, highlight = hl }
end

local function updateESP()
    if not PvPConfig.ESP_Enabled then
        DisableESP()
        return
    end
    if tick() - lastESPUpdate < 0.1 then return end
    lastESPUpdate = tick()

    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for _, targetP in ipairs(Players:GetPlayers()) do
        if targetP ~= player then
            local char = targetP.Character
            local head = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")

            if char and head and hum and root then
                local entry = espObjects[targetP]
                if not entry or entry.char ~= char or not entry.gui.Parent then
                    removeESP(targetP)
                    createESP(targetP)
                    entry = espObjects[targetP]
                end
                if entry then
                    local team, color = getTeamInfo(targetP)
                    local dist = math.floor((root.Position - myRoot.Position).Magnitude)
                    local hp = math.floor((hum.Health / math.max(hum.MaxHealth, 1)) * 100)
                    local lvl, fruit, bounty = "?", "None", 0
                    pcall(function() lvl = targetP.Data.Level.Value end)
                    pcall(function() fruit = targetP.Data.DevilFruit.Value end)
                    pcall(function() bounty = targetP.leaderstats["Bounty/Honor"].Value end)

                    local isPvpOff = targetP:GetAttribute("PvpDisabled") == true
                    local pvpTxt = isPvpOff and '<font color="rgb(0,255,0)">🟢 PvP OFF </font>' or "🔴 PvP ON "
                    local bM = type(bounty) == "number" and math.floor(bounty / 1000000) or 0
                    local warnTag = (type(bounty) == "number" and bounty > 10000000) and "⚠ " or ""

                    local parts = {}
                    if PvPConfig.ESP_Name then
                        table.insert(parts, warnTag .. "[" .. team .. '] <font color="rgb(255,255,0)">' .. targetP.Name .. "</font>")
                    end
                    if PvPConfig.ESP_Level then table.insert(parts, " [Lv." .. tostring(lvl) .. "]") end
                    if PvPConfig.ESP_Bounty then table.insert(parts, "\n" .. pvpTxt .. "| Bounty: " .. bM .. "M\n") end
                    if PvPConfig.ESP_Fruit then table.insert(parts, "Fruit: " .. tostring(fruit) .. "\n") end
                    if PvPConfig.ESP_Distance then table.insert(parts, tostring(dist) .. "m | ") end
                    if PvPConfig.ESP_HP then table.insert(parts, "HP " .. tostring(hp) .. "%") end

                    entry.label.TextColor3 = color
                    entry.label.TextSize = PvPConfig.ESP_TextSize
                    entry.label.Text = table.concat(parts)
                end
            else
                removeESP(targetP)
            end
        end
    end
end

local function EnableESP()
    if espRunning then return end
    espRunning = true
    task.spawn(function()
        while espRunning do
            pcall(updateESP)
            task.wait(0.1)
        end
    end)
end

