local SilentAimModule

local function stepTargetPlayer(dir)
	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			table.insert(list, plr.Name)
		end
	end
	table.sort(list)
	if #list == 0 then
		selectedTargetName = nil
		if SilentAimModule then SilentAimModule:SetSelectedPlayer(nil) end
		return
	end
	local opts = { "None" }
	for _, name in ipairs(list) do
		table.insert(opts, name)
	end
	local idx = table.find(opts, selectedTargetName or "None") or 1
	local nextIdx = ((idx - 1 + dir) % #opts) + 1
	selectedTargetName = (opts[nextIdx] == "None") and nil or opts[nextIdx]
	if SilentAimModule then
		SilentAimModule:SetSelectedPlayer(selectedTargetName)
	end
end

