local function refreshUIVisibility()
	local anyOpen = (not hiddenAll) and (activeTabName ~= nil) and (tabWindows[activeTabName] ~= nil)
	fxLayer.Visible = anyOpen
	fovFrame.Visible = aimState.enabled
	fovFrame.Size = UDim2.new(0, aimState.fovSize, 0, aimState.fovSize)

	if hiddenAll then
		tabsContainer.Visible = false
		topDock.Visible = true
		topDock.Size = UDim2.new(0, 152, 0, 40)
		logoBadge.Position = UDim2.new(0, 7, 0.5, -14)
		nameLabel.Position = UDim2.new(0, 40, 0, 4)
		nameLabel.Size = UDim2.new(0, 68, 1, -8)
		toggleVisibilityBtn.Text = "<"
		toggleVisibilityBtn.BackgroundColor3 = palette.white
		toggleVisibilityBtn.TextColor3 = palette.black
		toggleVisibilityBtn.Size = UDim2.new(0, 32, 1, -8)
		toggleVisibilityBtn.Position = UDim2.new(1, -37, 0, 4)
	else
		tabsContainer.Visible = true
		topDock.Visible = anyOpen
		topDock.Size = UDim2.new(0, 344, 0, 44)
		logoBadge.Position = UDim2.new(0, 8, 0.5, -14)
		nameLabel.Position = UDim2.new(0, 41, 0, 5)
		nameLabel.Size = UDim2.new(0, 62, 1, -10)
		toggleVisibilityBtn.Text = ">"
		toggleVisibilityBtn.BackgroundColor3 = palette.headerBlack
		toggleVisibilityBtn.TextColor3 = palette.white
		toggleVisibilityBtn.Size = UDim2.new(0, 34, 1, -10)
		toggleVisibilityBtn.Position = UDim2.new(1, -40, 0, 5)
	end

	for name, btn in pairs(tabButtons) do
		local selected = anyOpen and (name == activeTabName)
		TweenService:Create(btn, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundColor3 = selected and palette.white or palette.headerBlack,
			TextColor3 = selected and palette.black or palette.white
		}):Play()
	end
end

local function openTab(name)
	local targetWin = tabWindows[name]
	if not targetWin then return end

	hiddenAll = false
	activeTabName = name
	lastTabName = name

	for otherName, win in pairs(tabWindows) do
		win.Visible = (otherName == name)
	end

	targetWin.Size = UDim2.new(0, windowFullSize.X.Offset, 0, 0)
	TweenService:Create(targetWin, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = windowFullSize
	}):Play()

	refreshUIVisibility()
end

